{
  "name": "logsite",
  "displayName": "logsite",
  "description": "See how often each log line fires in production, what it costs, and catch bad logging, right next to the log call. Python, Java and Go.",
  "version": "0.2.0",
  "preview": true,
  "publisher": "rajpaynaik",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "homepage": "https://github.com/rajpaynaik/logsite#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajpaynaik/logsite"
  },
  "bugs": {
    "url": "https://github.com/rajpaynaik/logsite/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "logging",
    "logs",
    "observability",
    "python",
    "java",
    "go",
    "slf4j",
    "slog",
    "structlog",
    "loguru",
    "loki",
    "opensearch",
    "elasticsearch",
    "cloudwatch",
    "lint"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:go",
    "workspaceContains:logsite.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "logsite",
      "properties": {
        "logsite.serverCommand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command that starts the logsite language server, e.g. `[\"/path/to/venv/bin/logsite\", \"serve\"]`. Leave empty to use the Python interpreter selected in VS Code (`python -m logsite serve`), then `logsite` on `PATH`. Install the server with `pip install \"logsite[lsp]\"`."
        }
      }
    },
    "commands": [
      {
        "command": "logsite.restart",
        "title": "Restart server",
        "category": "logsite"
      },
      {
        "command": "logsite.showOutput",
        "title": "Show output",
        "category": "logsite"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify --sourcemap",
    "watch": "npm run bundle -- --watch",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
